<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopUI.ViewModels"
             x:Class="DesktopUI.Views.PlayerCardView"
             x:DataType="vm:PlayerViewModel">
    
    <UserControl.Styles>
        <Style Selector="Border.playerCard">
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BoxShadow" Value="0 2 6 0 #20000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.25"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.playerCard.active">
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="3.5"/>
            <Setter Property="BoxShadow" Value="0 0 16 3 #AAFFD700, 0 4 12 0 #40000000"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="playerCard" Classes.active="{Binding IsActive}"
            Background="{Binding CardBackground}" Margin="10" Padding="10" 
            Opacity="{Binding OpacityPlayerCard}">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Row="0" Text="{Binding Name}" FontStyle="Italic" FontSize="16" Foreground="Black"/>
            
            <TextBlock Grid.Row="1" Text="{Binding DisplayText}" FontSize="{Binding DisplayFontSize}" FontWeight="Bold" Foreground="Black" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
            
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                <TextBox x:Name="InputBox" Grid.Column="0" Background="Transparent" Margin="0,0,5,0" Text="{Binding CurrentThrow}" HorizontalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" GotFocus="InputBox_OnGotFocus">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SubmitThrowCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                
            </Grid>
            
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                <TextBlock Text="{Binding AverageText}" FontSize="12" Foreground="Black" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding Checkout}" FontSize="12" Foreground="Black" Margin="0,5,0,0" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
    
</UserControl>