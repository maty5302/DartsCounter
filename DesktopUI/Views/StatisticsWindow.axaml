<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopUI.ViewModels"
        xmlns:lang="clr-namespace:DesktopUI"
        x:Class="DesktopUI.Views.StatisticsWindow"
        x:DataType="vm:StatisticsViewModel"
        Title="{x:Static lang:Strings.StatsMenu}" Width="400" Height="820"
        MinWidth="400" MinHeight="700"
        MaxWidth="400" MaxHeight="820"
        Icon="/Assets/IcoFiles/stats.ico"
        CanResize="True"
        CanMaximize="False"
        CanMinimize="False"
        >

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlDefaultBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.StatLabel">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,5"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlPageTextBaseMediumBrush}"/>
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="16,12,16,16">
        
        <TextBlock Grid.Row="0" 
                   Text="{x:Static lang:Strings.StatsMenu}" 
                   FontSize="28" 
                   FontWeight="Black" 
                   LetterSpacing="2"
                   HorizontalAlignment="Center" 
                   FontFamily="avares://DartsCounter/Assets/Fonts/#Sigmar One"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" Classes="Card">
                    <StackPanel>
                        <TextBlock Text= "{x:Static lang:Strings.StatisticsCreatePlayer}" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                            <TextBox Grid.Column="0" Text="{Binding NewPlayerName}" PlaceholderText="{x:Static lang:Strings.StatisticsTypeName}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{x:Static lang:Strings.StatisticsCreateButton}" Command="{Binding CreatePlayerCommand}" VerticalAlignment="Center" Padding="16,6"/>
                        </Grid>

                        <Button Content="{x:Static lang:Strings.StatisticsImport}" 
                                Command="{Binding ImportOldDatabaseCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center" 
                                Margin="0,0,0,6" 
                                Background="#220088FF" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="Card">
                    <StackPanel>
                        <TextBlock Text="{x:Static lang:Strings.StatisticsManage}" Classes="SectionHeader"/>
                        
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                            <ComboBox Grid.Column="0" 
                                      ItemsSource="{Binding Players}" 
                                      SelectedItem="{Binding SelectedPlayer}"
                                      HorizontalAlignment="Stretch" 
                                      Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlayerName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="{x:Static lang:Strings.StatisticsRemove}" Command="{Binding DeletePlayerCommand}" Background="#33FF0000" Foreground="#FF5555"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                            <TextBox Grid.Column="0" Text="{Binding RenamePlayerName}" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="{x:Static lang:Strings.StatisticsRename}" Command="{Binding RenamePlayerCommand}"/>
                        </Grid>
                        
                        <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,8">
                            <TextBlock Grid.Column="0" Text="{x:Static lang:Strings.StatisticsDetails}" Classes="SectionHeader" VerticalAlignment="Center" Margin="0"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailableYears}" 
                                      SelectedItem="{Binding SelectedYear}"
                                      PlaceholderText="{x:Static lang:Strings.StatisticsYearPlaceholder}"
                                      Width="120"
                                      HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Center">
                                    
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static lang:Strings.StatisticsMatchesCount}" Classes="StatLabel"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MatchesPlayed}" Classes="StatValue"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static lang:Strings.StatisticsVictoryCount}" Classes="StatLabel"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Wins}" Classes="StatValue"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static lang:Strings.StatisticsHighestOut}" Classes="StatLabel"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HighestOut}" Classes="StatValue"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static lang:Strings.StatisticsAverage}" Classes="StatLabel"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Average, StringFormat=\{0:F2\}}" Classes="StatValue"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="60+:" Classes="StatLabel"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Sixty}" Classes="StatValue"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="100+:" Classes="StatLabel"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Hundred}" Classes="StatValue"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="120+:" Classes="StatLabel"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Hundred20}" Classes="StatValue"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="180:" Classes="StatLabel"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Hundred80}" Classes="StatValue" Foreground="#FF8C00"/>
                        </Grid>
                        
                    </StackPanel>
                </Border>

        <Border Grid.Row="3" Classes="Card" Margin="0">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="{x:Static lang:Strings.StatisticsAchievements}" Classes="SectionHeader" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6" Margin="0,0,6,0">
                        
                        <!-- 1. Sladké vítězství -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlDefaultBaseLowBrush}" ToolTip.Tip="{x:Static lang:Strings.AchCupImage}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Image Grid.Column="0" Source="{Binding AchCupImage}" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static lang:Strings.AchCupTitle}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{x:Static lang:Strings.AchCupImage}" FontSize="11" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0">
                                    <Border Background="#224CAF50" CornerRadius="4" Padding="6,2" IsVisible="{Binding AchCupUnlocked}">
                                        <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" IsVisible="{Binding !AchCupUnlocked}">
                                        <TextBlock Text="🔒" FontSize="10"/>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>

                        <!-- 2. Začátek kariéry -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlDefaultBaseLowBrush}" ToolTip.Tip="{x:Static lang:Strings.AchCup20Image}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Image Grid.Column="0" Source="{Binding AchCup20Image}" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static lang:Strings.AchCup20Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{x:Static lang:Strings.AchCup20Image}" FontSize="11" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0">
                                    <Border Background="#224CAF50" CornerRadius="4" Padding="6,2" IsVisible="{Binding AchCup20Unlocked}">
                                        <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" IsVisible="{Binding !AchCup20Unlocked}">
                                        <TextBlock Text="🔒" FontSize="10"/>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>

                        <!-- 3. Budoucí profesionál -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlDefaultBaseLowBrush}" ToolTip.Tip="{x:Static lang:Strings.AchCup100Image}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Image Grid.Column="0" Source="{Binding AchCup100Image}" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static lang:Strings.AchCup100Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{x:Static lang:Strings.AchCup100Image}" FontSize="11" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0">
                                    <Border Background="#224CAF50" CornerRadius="4" Padding="6,2" IsVisible="{Binding AchCup100Unlocked}">
                                        <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" IsVisible="{Binding !AchCup100Unlocked}">
                                        <TextBlock Text="🔒" FontSize="10"/>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>

                        <!-- 4. Expert na šipky -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlDefaultBaseLowBrush}" ToolTip.Tip="{x:Static lang:Strings.AchMore100Image}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Image Grid.Column="0" Source="{Binding AchMore100Image}" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static lang:Strings.AchMore100Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{x:Static lang:Strings.AchMore100Image}" FontSize="11" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0">
                                    <Border Background="#224CAF50" CornerRadius="4" Padding="6,2" IsVisible="{Binding AchMore100Unlocked}">
                                        <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" IsVisible="{Binding !AchMore100Unlocked}">
                                        <TextBlock Text="🔒" FontSize="10"/>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>

                        <!-- 5. Má první 180! -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlDefaultBaseLowBrush}" ToolTip.Tip="{x:Static lang:Strings.Ach180Image}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Image Grid.Column="0" Source="{Binding Ach180Image}" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static lang:Strings.Ach180Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{x:Static lang:Strings.Ach180Image}" FontSize="11" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0">
                                    <Border Background="#224CAF50" CornerRadius="4" Padding="6,2" IsVisible="{Binding Ach180Unlocked}">
                                        <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" IsVisible="{Binding !Ach180Unlocked}">
                                        <TextBlock Text="🔒" FontSize="10"/>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>